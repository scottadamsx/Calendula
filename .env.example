# Supabase — from the project's API settings, or `supabase status` for local dev.
# Normally you shouldn't need to set these by hand: the Connectors page writes
# them here itself once you paste the four values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> Database -> Connection string (URI). Used once, in-app,
# to apply the schema migrations — never read anywhere else at request time.
SUPABASE_DB_URL=

# Anthropic — ingestion, digest rendering, daily brief, overload triage (spec §11).
ANTHROPIC_API_KEY=

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" on
# scheduled requests to /api/cron/*. Optional locally (routes skip the check
# when unset) — set it in production once cron jobs are deployed.
CRON_SECRET=

